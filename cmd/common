upgrade_init() {
    log_msg "执行升级前的准备工作..."
    stop_process
    log_msg "升级前准备完成"
    return 0
}

# 升级后回调
upgrade_callback() {
    log_msg "执行升级后的处理工作..."

    # 依赖同步（对齐商店版升级回调：不赌 install_callback 是否重跑，
    # fpk 升级替换 server 代码后确保 venv 依赖与新代码匹配）
    if [ ! -x "${QWENPAW_VENV}/bin/python3" ]; then
        log_msg "虚拟环境缺失，正在重建..."
        /usr/bin/python3 -m venv "${QWENPAW_VENV}" >> "${LOG_FILE}" 2>&1
        "${QWENPAW_VENV}/bin/pip" config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple/ >/dev/null 2>&1
    fi
    log_msg "同步依赖..."
    clean_orphan_kernel
    "${QWENPAW_VENV}/bin/pip" install --default-timeout=30 --retries 3 -e "${QWENPAW_SRC}" \
        >> "${LOG_FILE}" 2>&1 \
        && { log_msg "依赖同步完成"; _assert_reme_ai_aligned; } \
        || log_msg "依赖同步失败（服务仍可尝试启动），请查看日志"

    # 权属治理（对齐商店版）
    if [ -n "${TRIM_USERNAME}" ] && [ -n "${TRIM_GROUPNAME}" ]; then
        chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGVAR}" 2>/dev/null || true
        chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" ${TRIM_DATA_SHARE_PATHS%%:*} 2>/dev/null || true
    fi

    return 0
}

# 配置初始化
config_init() {
    log_msg "执行配置初始化..."
    return 0
}

# 配置回调
config_callback() {
    log_msg "执行配置回调..."

    # wizard/config 目前只有一个可改项：qwenpaw_webui_port（WebUI 端口）。
    # 端口变更必须重启（进程要重新 bind）；但「应用权限」里新增可访问
    # 文件夹也会走到这里，而它由文件系统 ACL 即时执法、内核并不读取相关
    # 环境变量，重启毫无收益，反而造成约 2 分钟不可用。
    # 故：只在端口真的变了才停服，其余变更直接返回。
    # （旧注释提到的"认证账号密码"属商店版 com.dustinky.qwenpaw 的向导，
    #   本包 wizard/config 里没有这些字段。）
    local new_port="${qwenpaw_webui_port:-2277}"
    local old_port=""
    if [ -f "${PORT_STAMP}" ]; then
        old_port=$(cat "${PORT_STAMP}" 2>/dev/null)
    fi

    if [ -n "${old_port}" ] && [ "${new_port}" = "${old_port}" ]; then
        log_msg "端口未变更（${new_port}），无需重启"
        return 0
    fi

    log_msg "端口 ${old_port:-<未记录>} -> ${new_port}，停止服务以重新监听"
    stop_process
    log_msg "配置已更新，服务将自动重启"
    return 0
}
#!/bin/bash
# 公共函数库(仿自FnDepot)
# 所有 cmd 脚本共用的函数和变量

# 应用信息
APP_NAME="QwenPaw"
LOG_FILE="${TRIM_PKGVAR}/info.log"
GATEWAY_LOG_FILE="${TRIM_PKGVAR}/fngateway.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# 路径
QWENPAW_VENV="${TRIM_PKGVAR}/venv"  # Python 虚拟环境
QWENPAW_SRC="${TRIM_APPDEST}/server" # QwenPaw 源码目录

# 端口
QWENPAW_PORT="${qwenpaw_webui_port}"

# 环境变量
export HOME="${TRIM_PKGVAR}/data"
export PYTHONPATH="${QWENPAW_SRC}:${PYTHONPATH}"
export PIP_CACHE_DIR="${TRIM_PKGVAR}/.pip_cache"
export QWENPAW_AUTH_ENABLED=true
export QWENPAW_AUTH_USERNAME="${qwenpaw_auth_username}"
export QWENPAW_AUTH_PASSWORD="${qwenpaw_auth_password}"

# 工作目录显式化（对齐商店版 com.dustinky.qwenpaw 的做法）：
# 内核（-m qwenpaw app）默认用 $HOME/.qwenpaw，fngateway 回退到 data_dir/.qwenpaw，
# 此前全靠"默认值恰好一致"，任何一环默认值变化都会导致配置/数据路径分裂。
# 显式 export 后三处（内核 / fngateway / install_callback）钉死同一路径。
export QWENPAW_WORKING_DIR="${TRIM_PKGVAR}/data/.qwenpaw"

# 日志级别（安装向导 qwenpaw_log_level，缺省 info）
export QWENPAW_LOG_LEVEL="${qwenpaw_log_level:-info}"

# PyPI 镜像选择（安装向导 qwenpaw_pypi_mirror），落盘供 fngateway 内核直升使用
mkdir -p "${TRIM_PKGVAR}/data" 2>/dev/null || true
printf '%s' "${qwenpaw_pypi_mirror:-tsinghua}" > "${TRIM_PKGVAR}/data/pypi_mirror" 2>/dev/null || true

# Node.js (可选)
export PATH="/var/apps/nodejs_v22/target/bin:$PATH"
export npm_config_cache="${TRIM_PKGVAR}/.npm-cache"
export npm_config_tmp="${TRIM_PKGVAR}/.npm-tmp"

# Playwright 浏览器(FnDepot安装Chrome-for-Testing-yuexps)
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
export PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH="/var/apps/Chrome-for-Testing-yuexps/target/chrome-headless-shell"

# ===== 按天日志归档 =====
# 每天一个日志文件：logs/qwenpaw-console-YYYYMMDD.log（运行日志）、
# logs/qwenpaw-gateway-YYYYMMDD.log（网关日志），文件名按当天日期保留；
# 超过 6 个月（180 天）的日志自动清理。
# TRIM_PKGVAR 根下 info.log / fngateway.log 保留为「稳定锚点」符号链接指向当天文件，
# 内核输出 / 控制台网关 / 共享目录软链都经锚点访问，换天自动落到新文件。
LOG_DIR="${TRIM_PKGVAR}/logs"
LOG_RETENTION_DAYS=180

# 清理 6 个月之前的日志文件
cleanup_old_logs() {
    [ -d "${LOG_DIR}" ] || return 0
    find "${LOG_DIR}" -maxdepth 1 -type f -name 'qwenpaw-*.log' \
        -mtime +"${LOG_RETENTION_DAYS}" -delete 2>/dev/null || true
}

# 旧版（<=26.8.54）日志是 TRIM_PKGVAR 根下的普通文件，升级/首次写入时并入当天文件
migrate_legacy_logs() {
    local today console_file gateway_file
    today=$(date '+%Y%m%d')
    mkdir -p "${LOG_DIR}" 2>/dev/null || true
    console_file="${LOG_DIR}/qwenpaw-console-${today}.log"
    gateway_file="${LOG_DIR}/qwenpaw-gateway-${today}.log"
    if [ -f "${LOG_FILE}" ] && [ ! -L "${LOG_FILE}" ]; then
        if [ -f "${console_file}" ]; then
            cat "${LOG_FILE}" >> "${console_file}" 2>/dev/null || true
            rm -f "${LOG_FILE}"
        else
            mv "${LOG_FILE}" "${console_file}"
        fi
    fi
    if [ -f "${GATEWAY_LOG_FILE}" ] && [ ! -L "${GATEWAY_LOG_FILE}" ]; then
        if [ -f "${gateway_file}" ]; then
            cat "${GATEWAY_LOG_FILE}" >> "${gateway_file}" 2>/dev/null || true
            rm -f "${GATEWAY_LOG_FILE}"
        else
            mv "${GATEWAY_LOG_FILE}" "${gateway_file}"
        fi
    fi
}

# 断言锚点指向当天文件：换天 / 首写 / 升级后首次 log_msg 时自动切换并清理过期日志。
# readlink 比对命中时零开销（每行日志仅一次 readlink），避免每条日志都跑 find。
ensure_daily_logs() {
    mkdir -p "${LOG_DIR}" 2>/dev/null || true
    local today console_link gateway_link cur
    today=$(date '+%Y%m%d')
    console_link="logs/qwenpaw-console-${today}.log"
    gateway_link="logs/qwenpaw-gateway-${today}.log"
    cur=$(readlink "${LOG_FILE}" 2>/dev/null || true)
    if [ "${cur}" != "${console_link}" ]; then
        migrate_legacy_logs
        ln -sfn "${console_link}" "${LOG_FILE}" 2>/dev/null || true
        ln -sfn "${gateway_link}" "${GATEWAY_LOG_FILE}" 2>/dev/null || true
        cleanup_old_logs
    fi
}

# 日志函数
log_msg() {
    ensure_daily_logs
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

err_msg() {
    if [ -n "${TRIM_TEMP_LOGFILE}" ]; then
        echo "$1" >> "${TRIM_TEMP_LOGFILE}"
    fi
    log_msg "ERROR: $1"
    exit 1
}

# 检查进程（防 pid 复用误判：kill -0 通过后核对 cmdline 确属 QwenPaw；
# /proc 不可读或 cmdline 为空（僵尸等）时退回 kill -0 语义）
check_process() {
    local pid=$1
    if ! kill -0 "${pid}" 2>/dev/null; then
        return 1
    fi
    local cmd
    cmd=$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null) || return 0
    if [ -n "${cmd}" ]; then
        case "${cmd}" in
            *qwenpaw*|*fngateway*) return 0 ;;
            *) return 1 ;;
        esac
    fi
    return 0
}

# 检查应用状态
status() {
    ensure_daily_logs
    ensure_gateway

    if [ -f "${PID_FILE}" ]; then
        local pid=$(cat "${PID_FILE}")
        if check_process "${pid}"; then
            return 0 # 运行中
        fi
    fi
    return 3 # 未运行
}

# 控制台网关自愈：fngateway 是常驻进程，崩溃后控制台失联直到应用重启。
# 借 appcenter 周期性 status 探活拉起（CGI 版商店控制台每请求新进程，无此问题）。
ensure_gateway() {
    if ! pgrep -f "${TRIM_APPDEST}/fngateway.py" >/dev/null 2>&1; then
        log_msg "检测到控制台网关未运行，正在拉起..."
        rm -f "${TRIM_APPDEST}/web.sock" 2>/dev/null
        nohup "${QWENPAW_VENV}/bin/python3" -u "${TRIM_APPDEST}/fngateway.py" \
            --socket "${TRIM_APPDEST}/web.sock" \
            --prefix "/app/qwenpaw_yuexps" \
            --port "${QWENPAW_PORT}" \
            --log-file "${LOG_FILE}" \
            --gateway-log "${GATEWAY_LOG_FILE}" \
            --pid-file "${PID_FILE}" \
            --venv "${QWENPAW_VENV}" \
            --data-dir "${TRIM_PKGVAR}/data" \
            >> "${GATEWAY_LOG_FILE}" 2>&1 &
        log_msg "控制台网关已拉起"
    fi
}

# 启动应用
start_process() {
    # QW-009 防御：appcenter 装/升级会把 venv 存量权限改成 700（umask 管不了），
    # 每次启动主动断言遍历链（venv→bin/lib→python*→site-packages）与读位，
    # 保证治理沙箱子进程能读到 pyvenv.cfg、标准库与 site-packages
    # 必须放在 PID 早退分支之前：进程"已运行但权限已被整肃"时也要能自愈
    chmod 771 "$(dirname "${QWENPAW_VENV}")" 2>/dev/null || true
    chmod 711 "${QWENPAW_VENV}" "${QWENPAW_VENV}/bin" "${QWENPAW_VENV}/lib" 2>/dev/null || true
    chmod 711 "${QWENPAW_VENV}"/lib/python* "${QWENPAW_VENV}"/lib/python*/site-packages 2>/dev/null || true
    chmod 644 "${QWENPAW_VENV}/pyvenv.cfg" 2>/dev/null || true

    # 检查是否已经在运行
    if [ -f "${PID_FILE}" ]; then
        local pid=$(cat "${PID_FILE}")
        if check_process "${pid}"; then
            log_msg "${APP_NAME} 服务已在运行，PID: ${pid}"
            return 0
        fi
    fi

    # 启动前确保日志锚点指向当天文件（顺带清理 6 个月前的过期日志）
    ensure_daily_logs

    log_msg "正在启动 ${APP_NAME} ..."

    # Python 虚拟环境路径
    local python="${QWENPAW_VENV}/bin/python3"
    if [ ! -x "${python}" ]; then
        err_msg "${APP_NAME} 启动失败：Python 虚拟环境不存在"
        return 1
    fi

    # 启动QwenPaw服务
    log_msg "启动 ${APP_NAME}，端口: ${QWENPAW_PORT}"
    nohup "${python}" -m qwenpaw app --host 0.0.0.0 --port ${QWENPAW_PORT} \
        >> "${LOG_FILE}" 2>&1 &
    local app_pid=$!
    echo ${app_pid} > "${PID_FILE}"

    # 启动控制台网关服务（ensure_gateway 内含存活检测，避免重复拉起）
    ensure_gateway

    sleep 2
    if check_process "${app_pid}"; then
        log_msg "${APP_NAME} 启动成功，PID: ${app_pid}"
        return 0
    else
        rm -f "${PID_FILE}"
        err_msg "${APP_NAME} 启动失败，请查看日志: ${LOG_FILE}"
        return 1
    fi
}

# 停止应用
stop_process() {
    log_msg "正在停止 ${APP_NAME} 服务..."

    # 停止网关
    pkill -f "${TRIM_APPDEST}/fngateway.py" 2>/dev/null
    rm -f "${TRIM_APPDEST}/web.sock"

    # 检查 PID 文件是否存在
    if [ -f "${PID_FILE}" ]; then
        local pid=$(cat "${PID_FILE}")

        if check_process "${pid}"; then
            log_msg "停止 ${APP_NAME} 服务进程，PID: ${pid}"

            # 发送 SIGTERM 信号
            kill "${pid}" 2>/dev/null

            # 等待进程结束（最多等待 10 秒）
            local wait_count=0
            while check_process "${pid}" && [ ${wait_count} -lt 20 ]; do
                sleep 0.5
                wait_count=$((wait_count + 1))
            done

            # 如果进程还在运行，强制终止
            if check_process "${pid}"; then
                log_msg "进程未响应，强制终止"
                kill -9 "${pid}" 2>/dev/null
            fi

            log_msg "${APP_NAME} 服务已停止"
        else
            log_msg "${APP_NAME} 服务进程不存在"
        fi

        # 删除 PID 文件
        rm -f "${PID_FILE}"
    else
        log_msg "PID 文件不存在，${APP_NAME} 服务可能未运行"
    fi

    return 0
}

# 清理 site-packages 内的 qwenpaw 真身副本（历史「应用更新」pip 装包遗留）。
# 该副本会以 PathFinder 优先级压过 editable 安装（@appcenter/server/src），
# 且旧版 wheel 不带 console 静态资源 → 内核跑旧代码、网页版报
# "web console is not available"。editable 安装不会在 site-packages
# 留包目录（只有 __editable__*.pth），故见目录即删，安全。
clean_orphan_kernel() {
    local sp
    sp="$(ls -d "${QWENPAW_VENV}"/lib/python*/site-packages 2>/dev/null | head -1)"
    [ -n "${sp}" ] || return 0
    if [ -d "${sp}/qwenpaw" ]; then
        log_msg "检测到 site-packages 内 qwenpaw 真身副本（应用更新遗留），正在清理..."
        rm -rf "${sp}/qwenpaw" "${sp}/qwenpawmail_mcp" \
               "${sp}"/qwenpaw-*.dist-info "${sp}"/qwenpawmail_mcp-*.dist-info \
               2>/dev/null
        log_msg "孤儿副本清理完成，内核将改用 @appcenter/server 源码"
    fi
}

# 安装前初始化
install_init() {
    log_msg "执行安装前的准备工作..."

    # 校验端口是否被占用
    if netstat -tuln 2>/dev/null | grep -q ":${QWENPAW_PORT} "; then
        err_msg "Error: 端口 ${QWENPAW_PORT} 已被使用！"
        return 1
    fi

    return 0
}

# 安装后回调
install_callback() {
    log_msg "执行安装后的初始化工作..."

    # 创建 Python 虚拟环境（使用系统 Python）
    log_msg "创建 Python 虚拟环境..."
    local PYTHON_BIN="/usr/bin/python3"
    if [ ! -x "${PYTHON_BIN}" ]; then
        err_msg "未找到系统 Python（${PYTHON_BIN}）"
        return 1
    fi

    log_msg "使用 Python: ${PYTHON_BIN} $("${PYTHON_BIN}" --version 2>&1)"

    # 固定 umask 022，确保 venv 及 pip 安装产物权限稳定为 755/644
    # （避免裸跑 venv 时权限随执行环境 umask 漂移，导致卸载重装后权限变 700 服务不可读）
    # 窄摆法（QW-009）：作用域仅覆盖 venv 创建 + 依赖安装；恢复后再跑 init，
    # 避免 config.json / .qwenpaw.secret 等密钥文件继承 022 以 644 出生。
    # 既有环境升级不触发 init（config.json 存在即跳过），运行时文件不受本段影响。
    _qw_old_umask=$(umask)
    umask 022

    # 创建 venv
    if [ ! -d "${QWENPAW_VENV}" ] || [ ! -x "${QWENPAW_VENV}/bin/python3" ]; then
        log_msg "正在创建虚拟环境..."
        ${PYTHON_BIN} -m venv "${QWENPAW_VENV}" >> "${LOG_FILE}" 2>&1
        if [ ! -x "${QWENPAW_VENV}/bin/python3" ]; then
            err_msg "Python 虚拟环境创建失败"
            return 1
        fi
    else
        log_msg "虚拟环境已存在，跳过创建"
    fi
    log_msg "Python 环境就绪: $("${QWENPAW_VENV}/bin/python3" --version)"

    # 安装依赖
    log_msg "安装 QwenPaw 依赖..."
    local pip="${QWENPAW_VENV}/bin/pip"
    mkdir -p "${PIP_CACHE_DIR}"

    # 设置 pip 镜像源（按安装向导选择；fngateway 内核直升读取 data/pypi_mirror 同步使用）
    local mirror="${qwenpaw_pypi_mirror:-tsinghua}"
    case "${mirror}" in
        official)
            "${pip}" config unset global.index-url >/dev/null 2>&1 || true
            ;;
        aliyun)
            "${pip}" config set global.index-url https://mirrors.aliyun.com/pypi/simple/ >/dev/null 2>&1
            ;;
        ustc)
            "${pip}" config set global.index-url https://pypi.mirrors.ustc.edu.cn/simple/ >/dev/null 2>&1
            ;;
        *)
            "${pip}" config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple/ >/dev/null 2>&1
            ;;
    esac
    "${pip}" config set global.extra-index-url https://mirrors.aliyun.com/pypi/simple/ >/dev/null 2>&1

    # 安装项目并同步依赖
    log_msg "正在安装项目并同步依赖..."
    "${pip}" install --default-timeout=30 --retries 3 -e "${QWENPAW_SRC}" \
        >> "${LOG_FILE}" 2>&1

    if [ $? -ne 0 ]; then
        err_msg "依赖安装失败，请检查网络连接或查看日志: ${LOG_FILE}"
        return 1
    fi
    log_msg "依赖安装完成"

    # 恢复系统默认 umask：此后 init 生成的 config.json / .qwenpaw.secret 等
    # 密钥文件不再继承 022（venv 与 pip 产物已在此前以 755/644 固化）
    umask "${_qw_old_umask}"

    # 快速应用默认配置
    local config_file="${QWENPAW_WORKING_DIR}/config.json"
    if [ ! -f "${config_file}" ]; then
        log_msg "未检测到配置文件，正在初始化 ${APP_NAME} ..."
        local python="${QWENPAW_VENV}/bin/python3"
        "${python}" -m qwenpaw init --defaults --accept-security >> "${LOG_FILE}" 2>&1
        log_msg "${APP_NAME} 初始化完成"
    else
        log_msg "检测到现有配置，跳过初始化步骤"
    fi

    # 软链挂载
    log_msg "软链日志文件..."
    rm -rf "/var/apps/qwenpaw_yuexps/shares/qwenpaw_yuexps/info.log"
    ln -sf "${LOG_FILE}" "/var/apps/qwenpaw_yuexps/shares/qwenpaw_yuexps/info.log" >> "${LOG_FILE}" 2>&1
    rm -rf "/var/apps/qwenpaw_yuexps/shares/qwenpaw_yuexps/fngateway.log"
    ln -sf "${GATEWAY_LOG_FILE}" "/var/apps/qwenpaw_yuexps/shares/qwenpaw_yuexps/fngateway.log" >> "${LOG_FILE}" 2>&1

    # 权属治理（对齐商店版）：appcenter 回调可能以 root 执行，把运行时目录归还服务用户
    if [ -n "${TRIM_USERNAME}" ] && [ -n "${TRIM_GROUPNAME}" ]; then
        log_msg "修正运行时目录属主 (${TRIM_USERNAME}:${TRIM_GROUPNAME})..."
        chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGVAR}" 2>/dev/null || true
        chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" ${TRIM_DATA_SHARE_PATHS%%:*} 2>/dev/null || true
    fi

    return 0
}

# 卸载前初始化
uninstall_init() {
    log_msg "执行卸载前的准备工作..."
    # 停止应用
    stop_process
    log_msg "卸载前准备完成"
    return 0
}

# 卸载后回调
uninstall_callback() {
    log_msg "执行卸载后的清理工作..."
    # 清理 PID 文件
    rm -f "${PID_FILE}"

    # 根据用户选择删除数据
    if [ "$qwenpaw_data_action" = "delete" ]; then
        rm -rf ${TRIM_DATA_SHARE_PATHS%%:*}
        rm -rf ${TRIM_PKGVAR}
    fi

    log_msg "卸载后清理完成"
    return 0
}

# 升级前初始化
upgrade_init() {
    log_msg "执行升级前的准备工作..."
    stop_process
    log_msg "升级前准备完成"
    return 0
}

# 升级后回调
upgrade_callback() {
    log_msg "执行升级后的处理工作..."

    # 依赖同步（对齐商店版升级回调：不赌 install_callback 是否重跑，
    # fpk 升级替换 server 代码后确保 venv 依赖与新代码匹配）
    if [ ! -x "${QWENPAW_VENV}/bin/python3" ]; then
        log_msg "虚拟环境缺失，正在重建..."
        /usr/bin/python3 -m venv "${QWENPAW_VENV}" >> "${LOG_FILE}" 2>&1
        "${QWENPAW_VENV}/bin/pip" config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple/ >/dev/null 2>&1
    fi
    log_msg "同步依赖..."
    clean_orphan_kernel
    "${QWENPAW_VENV}/bin/pip" install --default-timeout=30 --retries 3 -e "${QWENPAW_SRC}" \
        >> "${LOG_FILE}" 2>&1 \
        && log_msg "依赖同步完成" \
        || log_msg "依赖同步失败（服务仍可尝试启动），请查看日志"

    # 权属治理（对齐商店版）
    if [ -n "${TRIM_USERNAME}" ] && [ -n "${TRIM_GROUPNAME}" ]; then
        chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGVAR}" 2>/dev/null || true
        chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" ${TRIM_DATA_SHARE_PATHS%%:*} 2>/dev/null || true
    fi

    return 0
}

# 配置初始化
config_init() {
    log_msg "执行配置初始化..."
    return 0
}

# 配置回调
config_callback() {
    log_msg "执行配置回调..."

    # 对齐商店版 com.dustinky.qwenpaw：配置（端口/认证账号密码等）变更后
    # 停止服务，由 appcenter 自动重启以应用新配置；此前为空实现，
    # 改配置后不重启会导致新配置一直不生效
    log_msg "配置已变更，正在停止服务以便应用新配置..."
    stop_process
    log_msg "配置已更新，服务将自动重启"
    return 0
}
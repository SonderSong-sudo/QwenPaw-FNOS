#!/bin/bash
# 公共函数库(仿自FnDepot)
# 所有 cmd 脚本共用的函数和变量

# 应用信息
APP_NAME="QwenPaw"
LOG_FILE="${TRIM_PKGVAR}/info.log"
GATEWAY_LOG_FILE="${TRIM_PKGVAR}/fngateway.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
PORT_STAMP="${TRIM_PKGVAR}/applied_port"  # 上次成功生效的 WebUI 端口

# 路径
QWENPAW_VENV="${TRIM_PKGVAR}/venv"  # Python 虚拟环境
QWENPAW_SRC="${TRIM_APPDEST}/server" # QwenPaw 源码目录

# 端口
QWENPAW_PORT="${qwenpaw_webui_port}"

# 环境变量
export HOME="${TRIM_PKGVAR}/data"
export PYTHONPATH="${QWENPAW_SRC}:${PYTHONPATH}"
export PIP_CACHE_DIR="${TRIM_PKGVAR}/.pip_cache"
# 登录认证：内核认证整体关闭（26.8.70 起向导已移除账号密码创建窗口，
# 内核侧无凭据可用）。经飞牛网关、局域网与桌面/手机客户端直连均免密。
#
# ⚠️ QW-022（26.8.71 用户实测「手机 App 打开应用弹 QwenPaw 登录页」根因）：
# 这里**不能只 unset**，必须显式 export false。内核侧有三个载体能偷偷把认证
# 重新打开，且它们全部是 override=False 语义（进程环境里已存在的键优先级最高）：
#   1) SECRET_DIR/envs.json —— 启动时 load_envs_into_environ() 注入 os.environ；
#   2) ${QWENPAW_WORKING_DIR}/.env —— constant.py 导入期 load_dotenv；
#   3) ${QWENPAW_SRC}/.env —— 同上。
# unset 会让出位置，残留值随即生效（auth/status 变 enabled:true → 直连端口弹登录页）；
# 显式 export false 反而把这三位全部压住（它们都不覆盖已存在的键）。
# 仅 QWENPAW_AUTH_USERNAME / PASSWORD 保持 unset（无凭据语义）。
export QWENPAW_AUTH_ENABLED=false
unset QWENPAW_AUTH_USERNAME QWENPAW_AUTH_PASSWORD 2>/dev/null || true

# 工作目录显式化（对齐商店版 com.dustinky.qwenpaw 的做法）：
# 内核（-m qwenpaw app）默认用 $HOME/.qwenpaw，fngateway 回退到 data_dir/.qwenpaw，
# 此前全靠"默认值恰好一致"，任何一环默认值变化都会导致配置/数据路径分裂。
# 显式 export 后三处（内核 / fngateway / install_callback）钉死同一路径。
export QWENPAW_WORKING_DIR="${TRIM_PKGVAR}/data/.qwenpaw"

# 日志级别（安装向导 qwenpaw_log_level，缺省 info）
export QWENPAW_LOG_LEVEL="${qwenpaw_log_level:-info}"

# PyPI 镜像选择（安装向导 qwenpaw_pypi_mirror），落盘供 fngateway 内核直升使用
mkdir -p "${TRIM_PKGVAR}/data" 2>/dev/null || true
printf '%s' "${qwenpaw_pypi_mirror:-tsinghua}" > "${TRIM_PKGVAR}/data/pypi_mirror" 2>/dev/null || true

# Node.js (可选)：fnOS 应用商店的 Node.js 应用（appid 如 nodejs_v22 / nodejs_v24）。
# 不写死版本——按实际安装探测，目录里确有 node 可执行文件才注入 PATH。
for _ndir in /var/apps/*node*/target/bin; do
    if [ -x "${_ndir}/node" ]; then
        export PATH="${_ndir}:$PATH"
        break
    fi
done
unset _ndir
export npm_config_cache="${TRIM_PKGVAR}/.npm-cache"
export npm_config_tmp="${TRIM_PKGVAR}/.npm-tmp"

# Playwright 浏览器(FnDepot安装Chrome-for-Testing-yuexps)
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
export PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH="/var/apps/Chrome-for-Testing-yuexps/target/chrome-headless-shell"

# ===== 按天日志归档 =====
# 每天一个日志文件：logs/qwenpaw-console-YYYYMMDD.log（运行日志）、
# logs/qwenpaw-gateway-YYYYMMDD.log（网关日志），文件名按当天日期保留；
# 超过 6 个月（180 天）的日志自动清理。
# TRIM_PKGVAR 根下 info.log / fngateway.log 保留为「稳定锚点」符号链接指向当天文件，
# 内核输出 / 控制台网关 / 共享目录软链都经锚点访问，换天自动落到新文件。
LOG_DIR="${TRIM_PKGVAR}/logs"
LOG_RETENTION_DAYS=180

# 清理 6 个月之前的日志文件
cleanup_old_logs() {
    [ -d "${LOG_DIR}" ] || return 0
    find "${LOG_DIR}" -maxdepth 1 -type f -name 'qwenpaw-*.log' \
        -mtime +"${LOG_RETENTION_DAYS}" -delete 2>/dev/null || true
}

# 旧版（<=26.8.54）日志是 TRIM_PKGVAR 根下的普通文件，升级/首次写入时并入当天文件
migrate_legacy_logs() {
    local today console_file gateway_file
    today=$(date '+%Y%m%d')
    mkdir -p "${LOG_DIR}" 2>/dev/null || true
    console_file="${LOG_DIR}/qwenpaw-console-${today}.log"
    gateway_file="${LOG_DIR}/qwenpaw-gateway-${today}.log"
    if [ -f "${LOG_FILE}" ] && [ ! -L "${LOG_FILE}" ]; then
        if [ -f "${console_file}" ]; then
            cat "${LOG_FILE}" >> "${console_file}" 2>/dev/null || true
            rm -f "${LOG_FILE}"
        else
            mv "${LOG_FILE}" "${console_file}"
        fi
    fi
    if [ -f "${GATEWAY_LOG_FILE}" ] && [ ! -L "${GATEWAY_LOG_FILE}" ]; then
        if [ -f "${gateway_file}" ]; then
            cat "${GATEWAY_LOG_FILE}" >> "${gateway_file}" 2>/dev/null || true
            rm -f "${GATEWAY_LOG_FILE}"
        else
            mv "${GATEWAY_LOG_FILE}" "${gateway_file}"
        fi
    fi
}

# 断言锚点指向当天文件：换天 / 首写 / 升级后首次 log_msg 时自动切换并清理过期日志。
# readlink 比对命中时零开销（每行日志仅一次 readlink），避免每条日志都跑 find。
ensure_daily_logs() {
    mkdir -p "${LOG_DIR}" 2>/dev/null || true
    local today console_link gateway_link cur
    today=$(date '+%Y%m%d')
    console_link="logs/qwenpaw-console-${today}.log"
    gateway_link="logs/qwenpaw-gateway-${today}.log"
    cur=$(readlink "${LOG_FILE}" 2>/dev/null || true)
    if [ "${cur}" != "${console_link}" ]; then
        migrate_legacy_logs
        ln -sfn "${console_link}" "${LOG_FILE}" 2>/dev/null || true
        ln -sfn "${gateway_link}" "${GATEWAY_LOG_FILE}" 2>/dev/null || true
        cleanup_old_logs
    fi
}

# 日志函数
log_msg() {
    ensure_daily_logs
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

# 操作横幅：═ 分隔条，把零散内核日志按「启动/停止」等操作分段，
# 与 fngateway._log_banner 的样式保持一致（控制台按钮与应用中心操作都能分段）
log_banner() {
    ensure_daily_logs
    local bar="════════════════════════"
    echo "${bar} $1 · $(date '+%Y-%m-%d %H:%M:%S') ${bar}" >> "${LOG_FILE}"
}

err_msg() {
    if [ -n "${TRIM_TEMP_LOGFILE}" ]; then
        echo "$1" >> "${TRIM_TEMP_LOGFILE}"
    fi
    log_msg "ERROR: $1"
    exit 1
}

# 检查进程（防 pid 复用误判：kill -0 通过后核对 cmdline 确属 QwenPaw；
# /proc 不可读或 cmdline 为空（僵尸等）时退回 kill -0 语义）
check_process() {
    local pid=$1
    if ! kill -0 "${pid}" 2>/dev/null; then
        return 1
    fi
    local cmd
    cmd=$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null) || return 0
    if [ -n "${cmd}" ]; then
        case "${cmd}" in
            *qwenpaw*|*fngateway*) return 0 ;;
            *) return 1 ;;
        esac
    fi
    return 0
}

# 检查应用状态
status() {
    ensure_daily_logs
    ensure_gateway

    if [ -f "${PID_FILE}" ]; then
        local pid=$(cat "${PID_FILE}")
        if check_process "${pid}"; then
            return 0 # 运行中
        fi
    fi
    return 3 # 未运行
}

# 控制台网关自愈：fngateway 是常驻进程，崩溃后控制台失联直到应用重启。
# 借 appcenter 周期性 status 探活拉起（CGI 版商店控制台每请求新进程，无此问题）。
ensure_gateway() {
    if ! pgrep -f "${TRIM_APPDEST}/fngateway.py" >/dev/null 2>&1; then
        log_msg "检测到控制台网关未运行，正在拉起..."
        rm -f "${TRIM_APPDEST}/web.sock" 2>/dev/null
        nohup "${QWENPAW_VENV}/bin/python3" -u "${TRIM_APPDEST}/fngateway.py" \
            --socket "${TRIM_APPDEST}/web.sock" \
            --prefix "/app/qwenpaw_yuexps" \
            --port "${QWENPAW_PORT}" \
            --log-file "${LOG_FILE}" \
            --gateway-log "${GATEWAY_LOG_FILE}" \
            --pid-file "${PID_FILE}" \
            --venv "${QWENPAW_VENV}" \
            --data-dir "${TRIM_PKGVAR}/data" \
            >> "${GATEWAY_LOG_FILE}" 2>&1 &
        log_msg "控制台网关已拉起"
    fi
}

# 启动应用
start_process() {
    # QW-009 防御：appcenter 装/升级会把 venv 存量权限改成 700（umask 管不了），
    # 每次启动主动断言遍历链（venv→bin/lib→python*→site-packages）与读位，
    # 保证治理沙箱子进程能读到 pyvenv.cfg、标准库与 site-packages
    # 必须放在 PID 早退分支之前：进程"已运行但权限已被整肃"时也要能自愈
    chmod 771 "$(dirname "${QWENPAW_VENV}")" 2>/dev/null || true
    chmod 711 "${QWENPAW_VENV}" "${QWENPAW_VENV}/bin" "${QWENPAW_VENV}/lib" 2>/dev/null || true
    chmod 711 "${QWENPAW_VENV}"/lib/python* "${QWENPAW_VENV}"/lib/python*/site-packages 2>/dev/null || true
    chmod 644 "${QWENPAW_VENV}/pyvenv.cfg" 2>/dev/null || true

    # QW-017 治理配置自愈：fpk 升级会把 sandbox_enabled 打回 true、
    # shell_evasion_checks 七项打回全 true（9-01/9-07 两次实证），
    # 每次启动断言回钦定态（8-29 方案A + 9-07 方案B）。
    # 只碰这两个键，其余 security 字段（tool_guard.enabled、disabled_rules、
    # file_guard、skill_scanner）一律不碰——那是用户/UI 管辖面。
    if [ -f "${QWENPAW_WORKING_DIR}/config.json" ]; then
        _qw017=$(/usr/bin/python3 - "${QWENPAW_WORKING_DIR}/config.json" <<'QW017' 2>/dev/null || true
import json, sys, shutil, os
p = sys.argv[1]
try:
    with open(p, encoding='utf-8') as f:
        d = json.load(f)
    sec = d.get('security', {})
    ec = sec.get('tool_guard', {}).get('shell_evasion_checks', {})
    dirty = []
    if sec.get('sandbox_enabled') is not False:
        sec['sandbox_enabled'] = False
        dirty.append('sandbox_enabled')
    for k in list(ec):
        if ec[k] is not False:
            ec[k] = False
            dirty.append('evasion.' + k)
    if dirty:
        shutil.copy2(p, p + '.selfheal-bak')
        tmp = p + '.tmp'
        with open(tmp, 'w', encoding='utf-8') as f:
            json.dump(d, f, ensure_ascii=False, indent=2)
        os.replace(tmp, p)
        print('restored: ' + ','.join(dirty))
except Exception as e:
    print('FAIL: ' + repr(e))
QW017
)
        if [ -n "${_qw017}" ]; then
            log_msg "QW-017 治理配置自愈 -> ${_qw017}"
        fi
    fi

    # QW-018 自愈：reme-ai<=0.4.1.10 的 status.py walk 会被 Dependency 占位的
    # loud guard 炸穿(hasattr 不吞 RuntimeError) → ReMe 状态面板恒 500。
    # 锚点式打补丁；已修复/文件已变则静默跳过。只碰 venv 内这一个文件。
    _qw018_status_py=$(find "${QWENPAW_VENV}/lib" -path "*/reme/steps/common/status.py" 2>/dev/null | head -1)
    if [ -n "${_qw018_status_py}" ] && ! grep -q "isinstance(value, Dependency)" "${_qw018_status_py}" 2>/dev/null; then
        _qw018=$(/usr/bin/python3 - "${_qw018_status_py}" <<'QW018' 2>/dev/null || true
import sys
p = sys.argv[1]
try:
    with open(p, encoding='utf-8') as f:
        s = f.read()
    imp_old = 'from ...components import BaseComponent, R'
    imp_new = 'from ...components import BaseComponent, R\nfrom ...components.base_component import Dependency'
    anchor = '        if isinstance(value, (type, ModuleType)):\n            return 0'
    guard = anchor + '''
        if isinstance(value, Dependency):
            # Unresolved bind() placeholders raise on __dict__ access by
            # design (loud misuse guard); count the stub itself and stop.
            return sys.getsizeof(value)'''
    if imp_old not in s or anchor not in s or 'isinstance(value, Dependency)' in s:
        sys.exit(0)  # 锚点不匹配或上游已修：静默跳过
    s = s.replace(imp_old, imp_new, 1).replace(anchor, guard, 1)
    import shutil, os
    shutil.copy2(p, p + '.bak-qw018')
    tmp = p + '.tmp'
    with open(tmp, 'w', encoding='utf-8') as f:
        f.write(s)
    os.replace(tmp, p)
    # 语法校验，失败回滚（防把服务锁死在 import 链上）
    import py_compile
    py_compile.compile(p, doraise=True)
    print('patched')
except Exception as e:
    try:
        import shutil as _sh; _sh.copy2(p + '.bak-qw018', p)
    except Exception:
        pass
    print('FAIL: ' + repr(e))
QW018
)
        case "${_qw018}" in
            patched) log_msg "QW-018 ReMe status.py 自愈补丁已施加" ;;
            FAIL*)   log_msg "QW-018 补丁失败已回滚: ${_qw018}" ;;
        esac
    fi

    # 检查是否已经在运行
    if [ -f "${PID_FILE}" ]; then
        local pid=$(cat "${PID_FILE}")
        if check_process "${pid}"; then
            log_msg "${APP_NAME} 服务已在运行，PID: ${pid}"
            return 0
        fi
    fi

    # 启动前确保日志锚点指向当天文件（顺带清理 6 个月前的过期日志）
    ensure_daily_logs

    log_banner "服务启动"

    log_msg "正在启动 ${APP_NAME} ..."

    # Python 虚拟环境路径
    local python="${QWENPAW_VENV}/bin/python3"
    if [ ! -x "${python}" ]; then
        err_msg "${APP_NAME} 启动失败：Python 虚拟环境不存在"
        return 1
    fi

    # 启动QwenPaw服务
    log_msg "启动 ${APP_NAME}，端口: ${QWENPAW_PORT}"
    # QW-022：拉内核前清一次认证开关残留（envs.json / .env），避免残留把
    # auth/status 顶回 enabled:true → 手机 App / 桌面图标直连端口弹登录页
    purge_stale_auth_env
    nohup "${python}" -m qwenpaw app --host 0.0.0.0 --port ${QWENPAW_PORT} \
        >> "${LOG_FILE}" 2>&1 &
    local app_pid=$!
    echo ${app_pid} > "${PID_FILE}"

    # 启动控制台网关服务（ensure_gateway 内含存活检测，避免重复拉起）
    ensure_gateway

    sleep 2
    if check_process "${app_pid}"; then
        log_msg "${APP_NAME} 启动成功，PID: ${app_pid}"
        # 记下本次实际生效的端口，供 config_callback 判断要不要重启
        echo "${QWENPAW_PORT}" > "${PORT_STAMP}" 2>/dev/null
        return 0
    else
        rm -f "${PID_FILE}"
        err_msg "${APP_NAME} 启动失败，请查看日志: ${LOG_FILE}"
        return 1
    fi
}

# 停止应用
stop_process() {
    # 仅在内核确在运行时打横幅：未运行时的停止调用（安装/卸载前清理）不打点
    if [ -f "${PID_FILE}" ] && check_process "$(cat "${PID_FILE}" 2>/dev/null)"; then
        log_banner "服务停止"
    fi

    log_msg "正在停止 ${APP_NAME} 服务..."

    # 停止网关
    pkill -f "${TRIM_APPDEST}/fngateway.py" 2>/dev/null
    rm -f "${TRIM_APPDEST}/web.sock"

    # 检查 PID 文件是否存在
    if [ -f "${PID_FILE}" ]; then
        local pid=$(cat "${PID_FILE}")

        if check_process "${pid}"; then
            log_msg "停止 ${APP_NAME} 服务进程，PID: ${pid}"

            # 发送 SIGTERM 信号
            kill "${pid}" 2>/dev/null

            # 等待进程结束（最多等待 10 秒）
            local wait_count=0
            while check_process "${pid}" && [ ${wait_count} -lt 20 ]; do
                sleep 0.5
                wait_count=$((wait_count + 1))
            done

            # 如果进程还在运行，强制终止
            if check_process "${pid}"; then
                log_msg "进程未响应，强制终止"
                kill -9 "${pid}" 2>/dev/null
            fi

            log_msg "${APP_NAME} 服务已停止"
        else
            log_msg "${APP_NAME} 服务进程不存在"
        fi

        # 删除 PID 文件
        rm -f "${PID_FILE}"
    else
        log_msg "PID 文件不存在，${APP_NAME} 服务可能未运行"
    fi

    return 0
}

# 清理 site-packages 内的 qwenpaw 真身副本（历史「应用更新」pip 装包遗留）。
# 该副本会以 PathFinder 优先级压过 editable 安装（@appcenter/server/src），
# 且旧版 wheel 不带 console 静态资源 → 内核跑旧代码、网页版报
# "web console is not available"。editable 安装不会在 site-packages
# 留包目录（只有 __editable__*.pth），故见目录即删，安全。
clean_orphan_kernel() {
    local sp
    sp="$(ls -d "${QWENPAW_VENV}"/lib/python*/site-packages 2>/dev/null | head -1)"
    [ -n "${sp}" ] || return 0
    if [ -d "${sp}/qwenpaw" ]; then
        log_msg "检测到 site-packages 内 qwenpaw 真身副本（应用更新遗留），正在清理..."
        rm -rf "${sp}/qwenpaw" "${sp}/qwenpawmail_mcp" \
               "${sp}"/qwenpaw-*.dist-info "${sp}"/qwenpawmail_mcp-*.dist-info \
               2>/dev/null
        log_msg "孤儿副本清理完成，内核将改用 @appcenter/server 源码"
    fi
}

# QW-020 自愈断言：捆绑源码 pyproject 的 reme-ai pin 可能滞后于运行版 qwenpaw
# 的硬需求（editable 安装会静默降级 reme-ai → memory manager 集体拒启，
# 2026-09-12 实录：直升 2.2.1+0.4.1.11 后被 fpk 安装流降回 0.4.1.10）。
# 权威源＝已安装 qwenpaw 包内的 _REQUIRED_REME_VERSION 常量；不匹配则强制对齐。
_assert_reme_ai_aligned() {
    local _req _now _pip="${QWENPAW_VENV}/bin/pip"
    _req="$("${QWENPAW_VENV}/bin/python3" -c \
        'from qwenpaw.agents.memory.reme_light_memory_manager import _REQUIRED_REME_VERSION as r; print(r)' 2>/dev/null)"
    [ -z "${_req}" ] && return 0   # 旧版包无此常量：静默跳过，绝不阻断启动
    _now="$("${_pip}" show reme-ai 2>/dev/null | awk '/^Version:/{print $2}')"
    if [ "${_now}" != "${_req}" ]; then
        log_msg "QW-020 对齐: reme-ai ${_now:-缺失} -> ${_req}"
        "${_pip}" install --default-timeout=30 --retries 3 "reme-ai==${_req}" \
            >> "${LOG_FILE}" 2>&1 \
            || err_msg "QW-020 reme-ai 对齐失败，memory manager 可能拒启，需人工介入"
    fi
}

# QW-022 残留清理（治本，配合文件顶部的 export false）：
# 内核侧三个认证开关载体里遗留在盘上的 true 值会让「想开认证」的人被反噬
# （改了顶部 export 仍被旧值压回），控制台「服务信息」的认证状态也会与实际
# 不符，故启动时顺手清一次。只动 QWENPAW_AUTH_ENABLED / COPAW_AUTH_ENABLED
# 两个键，其余变量（含用户名/密码）一律不碰。全程 best-effort，绝不阻断启动。
purge_stale_auth_env() {
    local _python="${QWENPAW_VENV}/bin/python3" _out
    [ -x "${_python}" ] || return 0
    _out="$("${_python}" - <<'QW022' 2>/dev/null
import os
from pathlib import Path

KEYS = ("QWENPAW_AUTH_ENABLED", "COPAW_AUTH_ENABLED")
TRUTHY = ("true", "1", "yes", "on")
hits = []

# 载体 1：envs.json —— 内核启动时 load_envs_into_environ() 注入 os.environ，
# 且 inject 用 overwrite=False，进程环境里没有该键时会被它悄悄打开认证。
try:
    from qwenpaw.envs import delete_env_var, load_envs

    stored = load_envs()
    for key in KEYS:
        if str(stored.get(key, "")).strip().lower() in TRUTHY:
            delete_env_var(key)
            hits.append("envs.json:" + key)
except Exception:
    pass  # 旧版无 envs 模块 / 存储不可读：静默跳过

# 载体 2/3：.env 文件——constant.py 导入期 load_dotenv（override=False）。
# 只报告不改用户文件（顶部 export false 已足以压住它们）。
try:
    from qwenpaw.constant import WORKING_DIR

    cands = [Path(WORKING_DIR) / ".env", Path(os.environ.get("QWENPAW_SRC", "")) / ".env"]
    for path in cands:
        if not path.is_file():
            continue
        text = path.read_text(encoding="utf-8", errors="ignore")
        for line in text.splitlines():
            key, _, value = line.partition("=")
            if key.strip() in KEYS and value.strip().strip('"').lower() in TRUTHY:
                hits.append(str(path) + ":" + key.strip())
except Exception:
    pass

if hits:
    print("QW-022 已清除残留认证开关 -> " + "，".join(hits))
QW022
)"
    [ -n "${_out}" ] && log_msg "$(printf '%s' "${_out}" | tr '\n' ' ')"
    return 0
}

# 安装前初始化
install_init() {
    log_msg "执行安装前的准备工作..."

    # 校验端口是否被占用
    if netstat -tuln 2>/dev/null | grep -q ":${QWENPAW_PORT} "; then
        err_msg "Error: 端口 ${QWENPAW_PORT} 已被使用！"
        return 1
    fi

    return 0
}

# 安装后回调
install_callback() {
    log_msg "执行安装后的初始化工作..."

    # 创建 Python 虚拟环境（使用系统 Python）
    log_msg "创建 Python 虚拟环境..."
    local PYTHON_BIN="/usr/bin/python3"
    if [ ! -x "${PYTHON_BIN}" ]; then
        err_msg "未找到系统 Python（${PYTHON_BIN}）"
        return 1
    fi

    log_msg "使用 Python: ${PYTHON_BIN} $("${PYTHON_BIN}" --version 2>&1)"

    # 固定 umask 022，确保 venv 及 pip 安装产物权限稳定为 755/644
    # （避免裸跑 venv 时权限随执行环境 umask 漂移，导致卸载重装后权限变 700 服务不可读）
    # 窄摆法（QW-009）：作用域仅覆盖 venv 创建 + 依赖安装；恢复后再跑 init，
    # 避免 config.json / .qwenpaw.secret 等密钥文件继承 022 以 644 出生。
    # 既有环境升级不触发 init（config.json 存在即跳过），运行时文件不受本段影响。
    _qw_old_umask=$(umask)
    umask 022

    # 创建 venv
    if [ ! -d "${QWENPAW_VENV}" ] || [ ! -x "${QWENPAW_VENV}/bin/python3" ]; then
        log_msg "正在创建虚拟环境..."
        ${PYTHON_BIN} -m venv "${QWENPAW_VENV}" >> "${LOG_FILE}" 2>&1
        if [ ! -x "${QWENPAW_VENV}/bin/python3" ]; then
            err_msg "Python 虚拟环境创建失败"
            return 1
        fi
    else
        log_msg "虚拟环境已存在，跳过创建"
    fi
    log_msg "Python 环境就绪: $("${QWENPAW_VENV}/bin/python3" --version)"

    # 安装依赖
    log_msg "安装 QwenPaw 依赖..."
    local pip="${QWENPAW_VENV}/bin/pip"
    mkdir -p "${PIP_CACHE_DIR}"

    # 设置 pip 镜像源（按安装向导选择；fngateway 内核直升读取 data/pypi_mirror 同步使用）
    local mirror="${qwenpaw_pypi_mirror:-tsinghua}"
    case "${mirror}" in
        official)
            "${pip}" config unset global.index-url >/dev/null 2>&1 || true
            ;;
        aliyun)
            "${pip}" config set global.index-url https://mirrors.aliyun.com/pypi/simple/ >/dev/null 2>&1
            ;;
        ustc)
            "${pip}" config set global.index-url https://pypi.mirrors.ustc.edu.cn/simple/ >/dev/null 2>&1
            ;;
        *)
            "${pip}" config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple/ >/dev/null 2>&1
            ;;
    esac
    # 注意：不要设置 extra-index-url——pip 会把副源纳入版本解析（取所有源的最高
    # 版本），镜像副源滞后时会让「官方源」选择形同虚设（26.8.70 实测案例）
    echo "依赖安装源：${mirror}" >> "${LOG_FILE}"

    # 安装项目并同步依赖
    log_msg "正在安装项目并同步依赖..."
    "${pip}" install --default-timeout=30 --retries 3 -e "${QWENPAW_SRC}" \
        >> "${LOG_FILE}" 2>&1

    if [ $? -ne 0 ]; then
        err_msg "依赖安装失败，请检查网络连接或查看日志: ${LOG_FILE}"
        return 1
    fi
    log_msg "依赖安装完成"
    _assert_reme_ai_aligned   # QW-020：防止 pyproject 旧 pin 静默降级 reme-ai

    # 恢复系统默认 umask：此后 init 生成的 config.json / .qwenpaw.secret 等
    # 密钥文件不再继承 022（venv 与 pip 产物已在此前以 755/644 固化）
    umask "${_qw_old_umask}"

    # 快速应用默认配置
    local config_file="${QWENPAW_WORKING_DIR}/config.json"
    if [ ! -f "${config_file}" ]; then
        log_msg "未检测到配置文件，正在初始化 ${APP_NAME} ..."
        local python="${QWENPAW_VENV}/bin/python3"
        "${python}" -m qwenpaw init --defaults --accept-security >> "${LOG_FILE}" 2>&1
        log_msg "${APP_NAME} 初始化完成"
    else
        log_msg "检测到现有配置，跳过初始化步骤"
    fi

    # 软链挂载
    log_msg "软链日志文件..."
    rm -rf "/var/apps/qwenpaw_yuexps/shares/qwenpaw_yuexps/info.log"
    ln -sf "${LOG_FILE}" "/var/apps/qwenpaw_yuexps/shares/qwenpaw_yuexps/info.log" >> "${LOG_FILE}" 2>&1
    rm -rf "/var/apps/qwenpaw_yuexps/shares/qwenpaw_yuexps/fngateway.log"
    ln -sf "${GATEWAY_LOG_FILE}" "/var/apps/qwenpaw_yuexps/shares/qwenpaw_yuexps/fngateway.log" >> "${LOG_FILE}" 2>&1

    # 权属治理（对齐商店版）：appcenter 回调可能以 root 执行，把运行时目录归还服务用户
    if [ -n "${TRIM_USERNAME}" ] && [ -n "${TRIM_GROUPNAME}" ]; then
        log_msg "修正运行时目录属主 (${TRIM_USERNAME}:${TRIM_GROUPNAME})..."
        chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGVAR}" 2>/dev/null || true
        chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" ${TRIM_DATA_SHARE_PATHS%%:*} 2>/dev/null || true
    fi

    return 0
}

